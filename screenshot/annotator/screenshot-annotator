TOOLS = [
    ('pen', 'document-edit-symbolic', 'Pen (P)', 'p'),
    ('line', 'list-remove-symbolic', 'Line (L)', 'l'),
    ('arrow', 'go-next-symbolic', 'Arrow (A)', 'a'),
    ('rect', 'shape:rect', 'Rectangle (R)', 'r'),
