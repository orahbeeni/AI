1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION @VERSION4@
PRODUCTVERSION @VERSION4@
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Sketchframe screen designer"
      VALUE "ProductName", "Sketchframe"
      VALUE "FileVersion", "@VERSION@"
      VALUE "ProductVersion", "@VERSION@"
      VALUE "OriginalFilename", "sketchframe.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
